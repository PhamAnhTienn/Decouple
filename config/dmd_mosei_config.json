{
    "model_name": "dmd",
    "need_data_aligned": true,
    "need_model_aligned": false,
    "use_finetune": true,
    "use_bert": true,
    "early_stop": 3,
    "update_epochs": 10,
    "attn_mask": true,
    "attn_dropout_a": 0.0,
    "attn_dropout_v": 0.0,
    "relu_dropout": 0.0,
    "embed_dropout": 0.0,
    "res_dropout": 0.0,
    "dst_feature_dim_nheads": [
        30,
        6
    ],
    "batch_size": 128,
    "learning_rate": 0.0001,
    "nlevels": 4,
    "conv1d_kernel_size_l": 5,
    "conv1d_kernel_size_a": 5,
    "conv1d_kernel_size_v": 5,
    "text_dropout": 0.3,
    "attn_dropout": 0.4,
    "output_dropout": 0.5,
    "grad_clip": 0.6,
    "patience": 5,
    "weight_decay": 0.001,
    "is_distill": true,
    "transformers": "bert",
    "pretrained": "bert-base-uncased",
    "KeyEval": "Loss",
    "selection_metric": "MOSI",
    "scheduler_metric": "MOSI"
}