{
    "model_name": "lnln",
    "need_data_aligned": true,
    "use_bert": true,
    "use_finetune": true,
    "batch_size": 64,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "num_epochs": 200,
    "early_stop": 5,
    "update_epochs": 1,
    "transformers": "bert",
    "pretrained": "bert-base-chinese",
    "KeyEval": "Loss",
    "grad_clip": -1.0,
    "patience": 10,
    "lnln_alpha": 0.9,
    "lnln_beta": 0.6,
    "lnln_gamma": 0.1,
    "lnln_sigma": 1.0,
    "lnln_model": {
        "feature_extractor": {
            "bert_pretrained": "bert-base-chinese",
            "input_length": [
                39,
                55,
                400
            ],
            "token_length": [
                8,
                8,
                8
            ],
            "heads": 8,
            "input_dims": [
                768,
                709,
                33
            ],
            "hidden_dims": [
                128,
                128,
                128
            ],
            "depth": 2
        },
        "dmc": {
            "proxy_dominant_feature_generator": {
                "input_length": 24,
                "token_length": 8,
                "depth": 2,
                "heads": 8,
                "input_dim": 128,
                "hidden_dim": 128
            },
            "effectiveness_discriminator": {
                "input_dim": 128,
                "hidden_dim": 64,
                "out_dim": 2
            },
            "completeness_check": {
                "input_length": 8,
                "token_length": 1,
                "depth": 2,
                "heads": 8,
                "input_dim": 128,
                "hidden_dim": 128
            }
        },
        "reconstructor": {
            "input_length": 8,
            "depth": 2,
            "heads": 8,
            "input_dim": 128,
            "hidden_dim": 128
        },
        "dmml": {
            "language_encoder": {
                "input_length": 8,
                "token_length": 8,
                "depth": 2,
                "heads": 8,
                "input_dim": 128,
                "hidden_dim": 128
            },
            "hyper_modality_learning": {
                "depth": 3,
                "heads": 8,
                "input_dim": 128,
                "hidden_dim": 128
            },
            "fuison_transformer": {
                "source_length": 8,
                "tgt_length": 8,
                "depth": 4,
                "heads": 8,
                "input_dim": 128,
                "hidden_dim": 128
            },
            "regression": {
                "input_dim": 128,
                "out_dim": 1
            }
        }
    }
}
